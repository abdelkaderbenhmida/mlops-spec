pipeline {
    agent any

    environment {
        MLFLOW_TRACKING_URI = 'http://localhost:5000'
        REGISTRY = 'docker.io/<org>/churn-api'
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Test') {
            steps {
                sh 'python3 -m pytest api/ tests/'
                sh 'python3 ml/evaluate.py'
            }
        }

        stage('Train') {
            steps {
                sh 'python3 ml/train.py'
            }
        }

        stage('Drift & Retrain') {
            steps {
                // Detect data drift vs reference; auto-retrain + re-evaluate
                // when the drift score exceeds the threshold.
                sh 'python3 ml/monitoring/drift_detector.py'
                sh 'python3 ml/monitoring/retraining_trigger.py'
            }
        }

        stage('Build') {
            steps {
                sh "docker build -t ${REGISTRY}:\$BUILD_NUMBER -f docker/api/Dockerfile docker/api"
            }
        }

        stage('Push') {
            steps {
                sh "docker push ${REGISTRY}:\$BUILD_NUMBER"
            }
        }

        stage('Deploy') {
            steps {
                sh "kubectl set image deployment/churn-api churn-api=${REGISTRY}:\$BUILD_NUMBER -n mlops"
                sh 'kubectl rollout status deployment/churn-api -n mlops'
            }
        }
    }

    post {
        success { echo 'Churn API deployed successfully.' }
        failure { echo 'Pipeline failed.' }
    }
}